{
  "name": "aigtm",
  "private": true,
  "packageManager": "pnpm@10.26.2",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:seed": "pnpm --filter @aigtm/db seed && pnpm --filter @aigtm/agent-runtime sync-specs",
    "db:generate": "pnpm --filter @aigtm/db generate",
    "db:migrate": "pnpm --filter @aigtm/db migrate",
    "db:sync": "pnpm --filter @aigtm/agent-runtime sync-specs"
  },
  "devDependencies": {
    "turbo": "^2.5.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4",
    "tsx": "^4.20.3",
    "@types/node": "^22.15.0",
    "typescript-eslint": "^8.34.0",
    "eslint": "^9.28.0",
    "@playwright/test": "^1.53.0"
  },
  "engines": {
    "node": ">=20"
  }
}
